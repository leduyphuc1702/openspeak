# Copy to /etc/openspeak.env (chmod 600). Never commit the real file.
PORT=8443
# Folder served at /download/ (test builds of the iOS app). Remove to turn it off.
DOWNLOAD_DIR=/opt/openspeak/download
# Web root that the port-80 web server already serves at /.well-known/acme-challenge/.
ACME_WEBROOT=/var/www/certbot
# Optional server LLM. LLM_API_FORMAT: openai-chat-completions | openai-responses | anthropic-messages
# LLM_API_FORMAT=openai-chat-completions
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_VISION_MODEL=gpt-4o-mini
# LLM_TIMEOUT=60
# Learners may send their own LLM in X-LLM-* headers (set 0 to refuse).
# LLM_CLIENT_CONFIG=1
# --- Shared hosting ---
# Comma-separated access keys, one per learner. Empty = open server (local use only).
# Each learner enters their key in Profile > AI server; the app sends it as
# "Authorization: Bearer <key>" (or send "X-API-Key: <key>"). /health and /download stay open.
OPENSPEAK_API_KEYS=
# Requests per minute per key (or per IP when no keys are set).
OPENSPEAK_RATE_LIMIT=120
# Largest request body in MB. Articulation coaching can carry 8 close-up photos.
OPENSPEAK_MAX_BODY_MB=16
# Expensive requests (scoring, LLM, audio) allowed at once; others wait, then get 503.
OPENSPEAK_MAX_CONCURRENT=2
OPENSPEAK_QUEUE_SECONDS=2
# One log line per request with a hashed identity (never the key). 0 turns it off.
OPENSPEAK_ACCESS_LOG=1
# Set 1 only behind your own reverse proxy, so X-Forwarded-For is trusted.
TRUST_PROXY=0
