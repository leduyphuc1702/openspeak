# Copy to /etc/phonopath.env (chmod 600). Never commit the real file.
PORT=8443
# Folder served at /download/ (test builds of the iOS app). Remove to turn it off.
DOWNLOAD_DIR=/opt/phonopath/download
# Web root that the port-80 web server already serves at /.well-known/acme-challenge/.
ACME_WEBROOT=/var/www/certbot
# Optional LLM (any /chat/completions endpoint).
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_VISION_MODEL=gpt-4o-mini
