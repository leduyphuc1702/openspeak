[Unit]
Description=PhonoPath pronunciation API
After=network-online.target
Wants=network-online.target

[Service]
User=phonopath
Group=phonopath
WorkingDirectory=/opt/phonopath/backend
EnvironmentFile=/etc/phonopath.env
Environment=HF_HOME=/opt/phonopath/hf
# /opt/phonopath/tls links to letsencrypt/live/<domain>; systemd reads the root-only key and hands it to the service user.
LoadCredential=cert:/opt/phonopath/tls/fullchain.pem
LoadCredential=key:/opt/phonopath/tls/privkey.pem
ExecStart=/opt/phonopath/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port ${PORT} --workers 1 --ssl-certfile %d/cert --ssl-keyfile %d/key
Restart=on-failure
RestartSec=5
# Leave room for other services on a small VPS: the acoustic model needs about 2 GB.
MemoryMax=3G
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes

[Install]
WantedBy=multi-user.target
